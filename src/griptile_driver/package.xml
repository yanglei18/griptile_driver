<?xml version="1.0"?>
<package format="3">
  <name>griptile_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 serial acquisition, status and recorded sample replay for GripTile.</description>
  <maintainer email="yanglei18@users.noreply.github.com">GripTile maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>griptile_msgs</exec_depend>
  <exec_depend>griptile_core</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
